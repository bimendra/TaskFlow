@TaskFlow.Api_HostAddress = https://localhost:7196

### =========================================
### Projects
### =========================================

### Get all projects
GET {{TaskFlow.Api_HostAddress}}/api/projects
Accept: application/json

###

### Create project
POST {{TaskFlow.Api_HostAddress}}/api/projects
Content-Type: application/json

{
  "name": "Mobile Inspection App",
  "description": "Offline-first inspection management project for field teams.",
  "status": "Active"
}

###

### Get project by id
@projectId = 1
GET {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json

###

### Update project
PUT {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}
Content-Type: application/json

{
  "name": "Mobile Inspection App - Phase 1",
  "description": "Updated description for the first delivery phase.",
  "status": "In Progress"
}

###

### Delete project
DELETE {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json

###

### =========================================
### Tasks
### =========================================

### Get tasks by project id
GET {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}/tasks
Accept: application/json

###

### Create task 1
POST {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}/tasks
Content-Type: application/json

{
  "title": "Set up RTK Query base API slice",
  "description": "Create the shared API slice and configure Redux store integration.",
  "status": "Todo",
  "priority": "High",
  "assignedTo": "Bimendra",
  "dueDateUtc": "2026-03-30T00:00:00Z"
}

###

### Create task 2
POST {{TaskFlow.Api_HostAddress}}/api/projects/{{projectId}}/tasks
Content-Type: application/json

{
  "title": "Build projects controller",
  "description": "Implement controller endpoints for project CRUD.",
  "status": "Todo",
  "priority": "Medium",
  "assignedTo": "Bimendra",
  "dueDateUtc": "2026-04-02T00:00:00Z"
}

###

### Update task
@taskId = 1
PUT {{TaskFlow.Api_HostAddress}}/api/tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Set up RTK Query base API slice",
  "description": "Create API slice, inject endpoints, and connect to React components.",
  "status": "In Progress",
  "priority": "High",
  "assignedTo": "Bimendra",
  "dueDateUtc": "2026-03-31T00:00:00Z"
}

###

### Delete task
DELETE {{TaskFlow.Api_HostAddress}}/api/tasks/{{taskId}}
Accept: application/json

###
